<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TODOアプリ V2</title>
  <link rel="stylesheet" href="/todo/todo.css">
  <link rel="stylesheet" href="/todo-v2/todo-v2.css">
</head>
<body>
  <main class="todo">
    <h1>TODOアプリ V2</h1>

    <form id="todo-form" class="todo-form" novalidate>
      <label for="todo-title" class="visually-hidden">TODOのタイトル</label>
      <input type="text" id="todo-title" name="title" placeholder="やることを入力（100文字まで）" autocomplete="off">
      <label for="todo-priority" class="visually-hidden">優先度</label>
      <select id="todo-priority" name="priority">
        <option value="high">高</option>
        <option value="normal" selected>中</option>
        <option value="low">低</option>
      </select>
      <button type="submit" id="todo-submit">登録</button>
    </form>

    <div class="todo-filters">
      <label>完了状態
        <select id="filter-completed">
          <option value="">すべて</option>
          <option value="false">未完了</option>
          <option value="true">完了</option>
        </select>
      </label>
      <label>優先度
        <select id="filter-priority">
          <option value="">すべて</option>
          <option value="high">高</option>
          <option value="normal">中</option>
          <option value="low">低</option>
        </select>
      </label>
    </div>

    <p id="todo-status" class="todo-status" role="status" aria-live="polite"></p>
    <p id="todo-error" class="todo-error" role="alert" hidden></p>
    <p id="todo-empty" class="todo-empty" hidden>TODOがありません</p>

    <ul id="todo-list" class="todo-list"></ul>

    <p class="todo-note">※ 授業用の公開ページです。個人情報は入力しないでください。V1（<a href="/todo">/todo</a>）とは別のデータです。</p>
  </main>

  <script src="/todo-v2/todo-v2.js"></script>
</body>
</html>
